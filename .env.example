# Copy to .env.local and fill in. NEVER put the service_role key or any secret here:
# every VITE_* variable is bundled into the browser app and is public.
# Local values are printed by `pnpm db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Optional: frontend error monitoring
VITE_SENTRY_DSN=
